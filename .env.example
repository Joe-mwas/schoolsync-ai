# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# Director account created the first time the app starts in production
# (development uses the demo school instead). Set SEED_DEMO=1 to load the
# demo school in production.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=

# Claude API (AI assistant, announcement drafting, WhatsApp auto-replies).
# Leave unset to run with the assistant disabled.
ANTHROPIC_API_KEY=

# WhatsApp Cloud API (Meta). Leave unset to run in simulation mode:
# outgoing messages are logged to the WhatsApp page instead of being sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify X-Hub-Signature-256 on incoming webhooks.
WHATSAPP_APP_SECRET=

# Where the JSON datastore lives (default: ./data/db.json)
DATA_FILE=
